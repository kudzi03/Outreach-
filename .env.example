# =============================================================================
#  Kitchen & Bath Remodeler Outreach — environment
# =============================================================================
#  These are read by the n8n *instance*, not by a .env file the workflows load.
#  Set them wherever your n8n gets its environment:
#
#    docker run --env-file .env  ...          (Docker)
#    environment:  in docker-compose.yml      (Compose)
#    Settings -> Variables                    (n8n Cloud / Enterprise)
#
#  IMPORTANT: n8n must allow Code nodes to read the environment. Ensure
#             N8N_BLOCK_ENV_ACCESS_IN_NODE=false  (this is the default).
#             If your instance blocks it, hard-code the values in the
#             "Init Config" / "W2 Config" nodes instead — they are the only
#             two places in either workflow that touch $env.
#
#  ---------------------------------------------------------------------------
#  YOU MAY NOT NEED THIS FILE AT ALL.
#
#  Every setting below can instead be typed straight into the SETTINGS block at
#  the top of two nodes: "Init Config" (Workflow 1) and "W2 Config" (Workflow 2).
#  That is the simplest path, and on n8n Cloud it is the ONLY path — Cloud
#  workflows cannot read environment variables.
#
#  Precedence: SETTINGS block  ->  environment variable  ->  built-in default.
#  Use this file if you run self-hosted and prefer keeping config out of the
#  workflow JSON.
#  ---------------------------------------------------------------------------
#
#  Copy to `.env`, fill in, and never commit it.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. AIRTABLE  (required)
# -----------------------------------------------------------------------------
# Personal Access Token: https://airtable.com/create/tokens
# Scopes REQUIRED — the schema engine will not work without all four:
#   data.records:read      read leads
#   data.records:write     write Status / dates
#   schema.bases:read      inspect existing columns
#   schema.bases:write     create the missing columns
# Access: add the specific base below to the token's allowed bases.
#
# The token itself is NOT read from here — it lives in the n8n credential
# "Airtable PAT (Header Auth)" as:  Name: Authorization  Value: Bearer patXXXX...
AIRTABLE_PAT=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From the base URL: https://airtable.com/appXXXXXXXXXXXXXX/tblYYYY...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table name exactly as it appears in Airtable (or its tbl... id).
AIRTABLE_TABLE_NAME=Leads

# true  = also create the bookkeeping columns (Message ID, Thread Subject,
#         Idempotency Key, Last Error, Reply Received At).
# false = create only Status / Last Contacted Date / Verification Status.
#         Threading and duplicate-send protection degrade without them.
MANAGE_OPTIONAL_FIELDS=true


# -----------------------------------------------------------------------------
# 2. EMAIL VERIFICATION — MillionVerifier  (required)
# -----------------------------------------------------------------------------
# https://app.millionverifier.com/api  (the key travels in the query string)
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_TIMEOUT_SECONDS=20

# false (default) = "catch_all"/"unknown" results are halted, per the brief.
# true            = send to catch-all domains too. Raises volume and risk;
#                   many legitimate remodelers run catch-all Workspace domains.
ALLOW_RISKY=false

# Re-verify addresses already marked Valid. Normally false — it triples cost.
FORCE_REVERIFY=false


# -----------------------------------------------------------------------------
# 3. SENDING — Postmark  (required)
# -----------------------------------------------------------------------------
# Server API token lives in the n8n credential "Postmark Server Token
# (Header Auth)" as:  Name: X-Postmark-Server-Token  Value: <token>
POSTMARK_SERVER_TOKEN=

# Use a dedicated BROADCAST/outbound stream for cold mail so replies and
# transactional traffic keep separate reputations.
POSTMARK_MESSAGE_STREAM=outbound

# Postmark stamps Message-ID as <returned-uuid@mtasv.net>. Only change this if
# Postmark support tells you your account uses a different domain.
POSTMARK_MESSAGE_ID_DOMAIN=mtasv.net

# --- SMTP alternative --------------------------------------------------------
# Set EMAIL_PROVIDER=smtp and swap "Send via Postmark" for an Email Send node.
# See docs/RUNBOOK.md — SMTP cannot return a Message-ID, so follow-ups thread
# on subject only.
EMAIL_PROVIDER=postmark
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# -----------------------------------------------------------------------------
# 4. SENDER IDENTITY  (required — CAN-SPAM)
# -----------------------------------------------------------------------------
SENDER_NAME=Nat Marlowe
SENDER_EMAIL=nat@yourdomain.com
SENDER_COMPANY=Marlowe Automations

# A real, physical postal address. Required by CAN-SPAM on every commercial
# email; the workflow refuses to start without it.
SENDER_POSTAL_ADDRESS=1200 W 6th St, Suite 200, Austin, TX 78703

# Optional. Leave blank to have replies go to SENDER_EMAIL. If you set it,
# point it at the SAME mailbox Workflow 2 watches over IMAP.
REPLY_TO_EMAIL=


# -----------------------------------------------------------------------------
# 4b. WHAT THE COPY MAY CLAIM
# -----------------------------------------------------------------------------
# The follow-ups are generated from these two numbers and can only say what
# they allow. Leave them at 0 until they are true: a borrowed claim dies on the
# first reply asking "which two?", and a fabricated client reference is an FTC
# deceptive-endorsement problem, not just a bad look.
#
# Kitchen & bath owners you have ACTUALLY spoken to about this.
#   0-2  -> follow-up 1 says "I'd guess..." and closes "Wrong, or about right?"
#   3+   -> "most guys I talk to say..."
REMODELERS_INTERVIEWED=0
#
# Remodelers ACTUALLY running this today.
#   0  -> "a 60-second video of how it works"
#   1  -> "...of what another remodeler set up"
#   2  -> "...of what two other remodelers set up"
#   3+ -> "...of what a few other remodelers set up"
REMODELER_CLIENTS=0


# -----------------------------------------------------------------------------
# 5. INBOUND — IMAP  (required for Workflow 2)
# -----------------------------------------------------------------------------
# Credentials live in the n8n credential "Outreach Inbox (IMAP)".
# Gmail/Workspace: use an App Password, not the account password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=nat@yourdomain.com
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# --- Webhook alternative -----------------------------------------------------
# Instead of IMAP, point Postmark inbound parsing at the workflow's webhook:
#   https://<your-n8n>/webhook/inbound-reply
# Then disable the IMAP node. Both triggers feed the same logic.


# -----------------------------------------------------------------------------
# 6. SCHEDULING
# -----------------------------------------------------------------------------
# IANA timezone. ALL business-day maths happens in this zone, so a Friday-night
# send is still "Friday" and its follow-up lands on Wednesday.
CAMPAIGN_TIMEZONE=America/New_York

# Comma-separated YYYY-MM-DD. Nothing is sent on these days, and they do not
# count toward the 3- and 4-business-day follow-up gates.
CAMPAIGN_HOLIDAYS=2026-01-01,2026-05-25,2026-07-03,2026-09-07,2026-11-26,2026-11-27,2026-12-24,2026-12-25

# The hard daily ceiling across ALL touches (touch 1 + both follow-ups).
DAILY_SEND_CAP=30

# Randomized gap between consecutive sends, in minutes.
# 30 emails x 20 min worst case = 9h40m, which fits an 08:00-18:00 window.
STAGGER_MIN_MINUTES=15
STAGGER_MAX_MINUTES=20

# Local hours the dispatcher is allowed to send in. The run trims the batch to
# what actually fits before END_HOUR rather than stranding it half-sent.
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=18


# -----------------------------------------------------------------------------
# 7. NOTIFICATIONS  (optional)
# -----------------------------------------------------------------------------
# Slack incoming webhook: https://api.slack.com/messaging/webhooks
# Leave blank to disable Slack entirely — both workflows skip it cleanly.
SLACK_WEBHOOK_URL=

# Also ping Slack when someone opts out. Off by default: opt-outs are noise.
NOTIFY_ON_OPT_OUT=false

# Optional SMS on a reply, via Twilio. Credentials live in the n8n credential
# "Twilio (Basic Auth)": username = Account SID, password = Auth Token.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ALERT_TO_NUMBER=


# -----------------------------------------------------------------------------
# 8. SAFETY SWITCH
# -----------------------------------------------------------------------------
# true = run the entire pipeline (schema, fetch, queue, verify, guard, Airtable
#        writes) but never hand a message to Postmark. Use it for the first run.
DRY_RUN=true
